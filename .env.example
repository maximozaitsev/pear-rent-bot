# Backend
APP_NAME=pear-rent-bot
ENV=development
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/pear_rent

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_BOT_USERNAME=replace_with_bot_username
TELEGRAM_MINI_APP_URL=https://example.com
MINI_APP_URL=https://example.com
ADMIN_TELEGRAM_IDS=123456789

# Business
TIMEZONE=Europe/Minsk
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Local/ngrok testing (single tunnel to frontend:5173; Vite proxies /api -> backend)
PUBLIC_BASE_URL=https://example.ngrok-free.dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://example.ngrok-free.dev

# Frontend (Vite). Use /api/v1 with Vite proxy for one ngrok URL, or https://<backend-tunnel>/api/v1 for two tunnels.
VITE_API_BASE_URL=/api/v1
VITE_DEV_PROXY_TARGET=http://backend:8000
VITE_TELEGRAM_BOT_USERNAME=replace_with_bot_username
